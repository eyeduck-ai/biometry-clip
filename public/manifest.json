{
  "manifest_version": 3,
  "name": "Biometry-Clip",
  "description": "Enter biometry once and fill multiple IOL calculators. Supports local OCR, PDF import, and optional cloud recognition.",
  "version": "0.4.1",
  "minimum_chrome_version": "140",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://iolcalculator.escrs.org/*",
    "https://calc.apacrs.org/*",
    "https://cookeformula.com/*",
    "https://www.cookeformula.com/*",
    "https://iolsolver.com/*",
    "https://www.iolformula.com/*",
    "https://iolformula.com/*",
    "https://www.evoiolcalculator.com/*",
    "https://evoiolcalculator.com/*",
    "https://tecnistoriccalc.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "Biometry-Clip · Open floating panel on calculators, or open workspace",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "sandbox": {
    "pages": [
      "src/ocr/sandbox.html"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "vendor-ocr/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "resources": [
        "index.html"
      ],
      "matches": [
        "https://iolcalculator.escrs.org/*",
        "https://calc.apacrs.org/*",
        "https://cookeformula.com/*",
        "https://www.cookeformula.com/*",
        "https://iolsolver.com/*",
        "https://www.iolformula.com/*",
        "https://iolformula.com/*",
        "https://www.evoiolcalculator.com/*",
        "https://evoiolcalculator.com/*",
        "https://tecnistoriccalc.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'; connect-src 'self' https: http://localhost:* http://127.0.0.1:*;",
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; connect-src 'self' chrome-extension: data:; worker-src 'self'; child-src 'none';"
  }
}
